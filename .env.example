# ═══════════════════════════════════════════════
# Voice Studio MVP — конфиг
# Скопируй: cp .env.example .env
# ═══════════════════════════════════════════════

# ── Обязательно ────────────────────────────────
COLAB_SECRET=change_me_min_8_chars

# ── Пути ───────────────────────────────────────
STORAGE_PATH=storage
DB_PATH=voice_studio.db
LOG_PATH=logs/session.log

# ── Лимиты ─────────────────────────────────────
MAX_FILE_SIZE_MB=200

# ── Сервер ─────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ── CORS (через запятую, без пробелов) ──────────
# start.sh добавит cloudflared URL автоматически
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ── Публичный URL ───────────────────────────────
# start.sh заполняет автоматически
# На Railway — не нужен (читается из RAILWAY_PUBLIC_DOMAIN)
PUBLIC_URL=

# ═══════════════════════════════════════════════
# Kaggle auto-trigger (опционально)
# Без этого — запускай Colab вручную
# ═══════════════════════════════════════════════
# kaggle.com → Settings → API → Create New Token
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_KERNEL_SLUG=voice-studio-worker

# ═══════════════════════════════════════════════
# Telegram уведомления (опционально)
# ═══════════════════════════════════════════════
# t.me/BotFather → /newbot
TELEGRAM_BOT_TOKEN=
# t.me/userinfobot → твой chat_id
TELEGRAM_CHAT_ID=
